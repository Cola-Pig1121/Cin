# Rin Docker 部署配置
#
# 复制为 .env 后按需修改：
#   cp .env.docker.example .env
#
# 不创建 .env 也能启动，所有配置都有可用默认值。
# 唯一强烈建议设置的是 JWT_SECRET —— 它用于签发登录令牌，
# 不设置时任何人都能伪造管理员会话。

# ============================================
# 必填（强烈建议）
# ============================================
# 登录令牌的签名密钥。生成方式：
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string

# 管理员账号，首次登录时自动创建
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ============================================
# 站点信息
# ============================================
NAME=Rin
DESCRIPTION=A lightweight personal blogging system
AVATAR=
PAGE_SIZE=5
RSS_ENABLE=false

# ============================================
# 运行时
# ============================================
# local    = 本地 SQLite + 容器内磁盘（默认，零外部依赖）
# supabase = Supabase Postgres + Supabase Storage
RIN_RUNTIME=local

# 宿主机暴露的端口
RIN_HOST_PORT=23365

# 时区，影响定时任务与时间显示
TZ=Asia/Shanghai

# ============================================
# 仅 supabase 模式需要
# ============================================
# Supabase Postgres 连接串，建议用连接池器地址（端口 6543）
# SUPABASE_DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase Storage 的 S3 兼容端点
# 表结构需要在 Supabase SQL Editor 中执行一次 server/sql-postgres/0000-init.sql
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=<project-region>
# S3_BUCKET=<bucket 名>
# S3_ACCESS_KEY_ID=<access key id>
# S3_SECRET_ACCESS_KEY=<secret access key>
# S3_FORCE_PATH_STYLE=false
# 留空则图片通过 /api/blob/<key> 读取
# S3_ACCESS_HOST=

# ============================================
# 可选：接入 Artalk 评论
# ============================================
# 评论走 Artalk 后端。地址由浏览器直接访问，所以要用浏览器能打开的地址，
# 而不是容器内地址（artalk:23366 那种只在 Docker 网络内可解析）。
#
# 用 docker-compose.artalk.yml 一起部署时，若从宿主机访问 Rin，
# 填 http://<你的宿主机IP>:23366 或 http://localhost:23366
# Artalk 后台里的站点地址也要与之对应。
#
# 留空则使用 Rin 内置评论。
# ARTALK_SERVER=http://192.168.21.250:23366
# ARTALK_SITE=Rin

# ============================================
# 可选：其他
# ============================================
# 新评论 Webhook 通知地址
# WEBHOOK_URL=

# 缓存存储模式：database（默认）或 s3
CACHE_STORAGE_MODE=database
