# Rin 本地开发配置
# 复制此文件为 .env.local 并填入你的实际配置

# ============================================
# 运行时选择
# ============================================
# cloudflare（默认）：D1 + R2 + Queues，需要 wrangler，仅用于部署到 Cloudflare
# local              ：本地 SQLite + 本地磁盘，不依赖 Cloudflare，适合本机部署
# supabase           ：Supabase Postgres 存数据 + S3 协议存文件
#
# 注意：这个值必须在进程启动前确定，因为数据库 schema 在模块加载时按它定型。
RIN_RUNTIME=local

# ---- 仅 local 运行时生效 ----
# 数据根目录，SQLite 与上传文件都在这里
# RIN_DATA_DIR=./data
# SQLite 数据库文件路径
# RIN_DB_FILE=./data/rin.db
# 上传文件目录
# RIN_UPLOAD_DIR=./data/uploads
# 前端构建产物目录（生产模式下由本地后端直接托管）
# RIN_CLIENT_DIST=./dist/client
# 定时任务间隔（毫秒），默认 20 分钟，对齐 Cloudflare 的 cron 配置
# CRON_INTERVAL_MS=1200000

# ---- 存储后端选择 ----
# 不填则自动判断：配了 S3_ENDPOINT 用 S3，否则用本地磁盘
# local = 本地磁盘；s3 = 任意 S3 兼容服务（Supabase Storage / R2 / MinIO）
# RIN_STORAGE_BACKEND=local

# ---- 仅 supabase 运行时生效 ----
# Supabase Postgres 连接串（Project Settings → Database → Connection string）
# 建议用连接池器地址（端口 6543）而非直连（5432）
# SUPABASE_DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ============================================
# 站点配置（可选，默认值如下）
# 注意：这些配置可以在部署后通过设置页面修改
# 配置优先级：设置页面 > 环境变量 > 默认值
# ============================================

# 网站基本信息（默认：Rin）
# NAME=Rin

# 网站描述（默认：A lightweight personal blogging system）
# DESCRIPTION=A lightweight personal blogging system

# 头像地址（默认：空）
# AVATAR=

# 分页大小（默认：5）
# PAGE_SIZE=5

# RSS 设置（默认：false）
# RSS_ENABLE=false

# ============================================
# 后端配置 (wrangler.toml 中的 vars)
# ============================================
BACKEND_PORT=11498

# S3/R2 存储配置
# 本地部署时这一段可以整段留空，会自动退回本地磁盘（data/uploads）
# 要用 S3 兼容服务（Supabase Storage / R2 / MinIO）时填下面四项
S3_FOLDER=images/
S3_CACHE_FOLDER=cache/
S3_REGION=auto
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_HOST=https://your-image-domain.com
S3_BUCKET=your-bucket-name
S3_FORCE_PATH_STYLE=false

# ---- Supabase Storage（走 S3 协议）----
# 在 Project Settings → Storage → S3 配置 中获取 endpoint、region 与密钥对
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=<project-region>
# S3_BUCKET=<你在 Supabase 中创建的 bucket 名>
# S3_ACCESS_KEY_ID=<生成的 access key id>
# S3_SECRET_ACCESS_KEY=<生成的 secret access key>
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_HOST=  # 留空则图片通过 /api/blob/<key> 读取，省去 CDN 配置

# 缓存存储模式配置
# s3: 使用 S3 存储缓存（默认，向前兼容）
# database: 使用数据库存储缓存（推荐，开箱即用）
CACHE_STORAGE_MODE=database

# Webhook 通知地址（可选）
WEBHOOK_URL=

# RSS 标题和描述
RSS_TITLE=Rin Development
RSS_DESCRIPTION=Development Environment

# 站点公开访问地址（可选）
# 用于生成 sitemap.xml / robots.txt 中的绝对链接；留空时自动回退到请求来源
# FRONTEND_URL=https://your-domain.com

# ============================================
# 敏感配置（会被加密存储）
# ============================================
# GitHub OAuth 配置（可选，如果不配置则只能使用账号密码登录）
RIN_GITHUB_CLIENT_ID=
RIN_GITHUB_CLIENT_SECRET=

# 管理员账号密码（用于账号密码登录，如果不配置 GitHub OAuth 则必须设置）
# 默认账号: admin
# 默认密码: admin123
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# JWT 密钥
JWT_SECRET=your-jwt-secret-key

# S3 访问密钥
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key

# ============================================
# 数据库配置
# ============================================
DB_NAME=rin
