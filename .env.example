# Rin 本地开发配置
# 复制此文件为 .env.local 并填入你的实际配置

# ============================================
# 站点配置（可选，默认值如下）
# 注意：这些配置可以在部署后通过设置页面修改
# 配置优先级：设置页面 > 环境变量 > 默认值
# ============================================

# 网站基本信息（默认：Rin）
# NAME=Rin

# 网站描述（默认：A lightweight personal blogging system）
# DESCRIPTION=A lightweight personal blogging system

# 头像地址（默认：空）
# AVATAR=

# 分页大小（默认：5）
# PAGE_SIZE=5

# RSS 设置（默认：false）
# RSS_ENABLE=false

# ============================================
# 后端配置 (wrangler.toml 中的 vars)
# ============================================
BACKEND_PORT=11498

# ============================================
# 对象存储后端（二选一，三种皆可）
#   r2       : Cloudflare R2 binding（需R2_BUCKET_NAME）
#   s3       : 任意 S3 兼容服务（R2 S3 API / MinIO / AWS S3）
#   supabase : Supabase Storage
# 留空时自动探测：配了 Supabase → supabase，有 R2_BUCKET_NAME → r2，否则 s3
# ============================================
# STORAGE_PROVIDER=s3

# ---------- 方案A：Supabase Storage ----------
# 后端设为 supabase 时填写。Project URL 与 bucket 名见
# Supabase 控制台 → Project Settings / Storage
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_STORAGE_BUCKET=rin
# bucket 是否为公开桶：
#   true  → 图片由 Supabase CDN 直接对外服务（推荐，性能更好）
#   false → 私有桶，图片经 Worker /api/blob 反代（service_role 绕过 RLS）
# SUPABASE_STORAGE_PUBLIC=true

# ---------- 方案 B：S3 兼容存储 ----------
# 后端为 s3 或 r2 时使用
S3_FOLDER=images/
S3_CACHE_FOLDER=cache/
S3_REGION=auto
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_HOST=https://your-image-domain.com
S3_BUCKET=your-bucket-name
S3_FORCE_PATH_STYLE=false

# 缓存存储模式配置
# s3: 使用 S3 存储缓存（默认，向前兼容）
# database: 使用数据库存储缓存（推荐，开箱即用）
CACHE_STORAGE_MODE=database

# Webhook 通知地址（可选）
WEBHOOK_URL=

# RSS 标题和描述
RSS_TITLE=Rin Development
RSS_DESCRIPTION=Development Environment

# 站点公开访问地址（可选）
# 用于生成 sitemap.xml / robots.txt 中的绝对链接；留空时自动回退到请求来源
# FRONTEND_URL=https://your-domain.com

# ============================================
# 敏感配置（会被加密存储）
# ============================================
# GitHub OAuth 配置（可选，如果不配置则只能使用账号密码登录）
RIN_GITHUB_CLIENT_ID=
RIN_GITHUB_CLIENT_SECRET=

# 管理员账号密码（用于账号密码登录，如果不配置 GitHub OAuth 则必须设置）
# 默认账号: admin
# 默认密码: admin123
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# JWT 密钥
JWT_SECRET=your-jwt-secret-key

# S3 访问密钥（后端为 supabase 时不需要）
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key

# Supabase service_role key（后端为 supabase 时必填）
# Supabase 控制台 → Project Settings → API → service_role
# 拥有 RLS 豁免权，可读写私有 bucket，部署时作为 Worker Secret 注入
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# 数据库配置
# ============================================
DB_NAME=rin
